		"cells": [
			{
				"cell_type": "code",
				"source": [
					"from pyspark.sql import SparkSession\n",
					"import dash\n",
					"from dash import dcc, html\n",
					"import plotly.express as px"
				],
				"execution_count": 4
			},
			{
				"cell_type": "code",
				"source": [
					"spark = SparkSession.builder.appName(\"PlotlyDashboard\").getOrCreate()\n",
					"\n",
					"df = spark.read.format(\"delta\").load(\"abfss://datalake@bessstorage.dfs.core.windows.net/silver/merged_delta\")\n",
					"pandas_df = df.toPandas()"
				],
				"execution_count": 2
			},
			{
				"cell_type": "code",
				"source": [
					"pandas_df.head()"
				],
				"execution_count": 3
			},
			{
				"cell_type": "code",
				"source": [
					"fig = px.line(pandas_df, x=\"datetime_minute\", y=\"BESSkW\", title=\"Power over Time\")"
				],
				"execution_count": 5
			},
			{
				"cell_type": "code",
				"source": [
					"fig.show()"
				],
				"execution_count": 6
			},
			{
				"cell_type": "code",
				"source": [
					"app = dash.Dash(__name__)\n",
					"\n",
					"fig = px.line(pandas_df, x=\"datetime_minute\", y=\"BESSkW\", title=\"Power over Time\")\n",
					"\n",
					"app.layout = html.Div([\n",
					"    html.H1(\"Battery Performance Dashboard\"),\n",
					"    dcc.Graph(figure=fig)\n",
					"])\n",
					"\n",
					"if __name__ == \"__main__\":\n",
					"    app.run_server(debug=True)"
				],
				"execution_count": 7
			}
		]
	}
